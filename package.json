{
  "name": "kcd-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "26",
    "bun": "1.3.14"
  },
  "imports": {
    "#app/*": "./services/site/app/*",
    "#other/*": "./other/*",
    "#tests/*": "./services/site/tests/*"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "bun run --filter kentcdodds.com dev",
    "prepare": "husky",
    "build": "bun run --filter kentcdodds.com build",
    "build:all": "nx run-many -t build",
    "test": "bun run --filter kentcdodds.com test",
    "test:all": "nx run-many -t test",
    "test:backend": "bun run --filter kentcdodds.com test:backend",
    "test:backend:watch": "bun run --filter kentcdodds.com test:backend:watch",
    "test:browser": "bun run --filter kentcdodds.com test:browser",
    "test:browser:watch": "bun run --filter kentcdodds.com test:browser:watch",
    "test:e2e:dev": "bun run --filter kentcdodds.com test:e2e:dev",
    "test:e2e:run": "bun run --filter kentcdodds.com test:e2e:run",
    "test:e2e:install": "bun run --filter kentcdodds.com test:e2e:install",
    "lint": "bun run --filter kentcdodds.com lint",
    "lint:all": "nx run-many -t lint",
    "format": "bun run --filter kentcdodds.com format",
    "format:staged": "lint-staged",
    "typecheck": "bun run --filter kentcdodds.com typecheck",
    "typecheck:all": "nx run-many -t typecheck",
    "precommit:verify": "bun run format:staged && bun run lint:all && bun run typecheck:all && bun run build:all",
    "prepush:verify": "bun run test:all",
    "validate": "bun run --filter kentcdodds.com validate",
    "setup": "bun install && bun run --filter kentcdodds.com setup",
    "nx:graph": "nx graph"
  },
  "devDependencies": {
    "@epic-web/config": "^2.0.0",
    "get-port": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "^22.5.4",
    "prettier": "^3.8.1"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "bcrypt",
    "esbuild",
    "fsevents",
    "msw",
    "nx",
    "sharp",
    "workerd"
  ]
}
